# 依赖
node_modules/

# 前端构建产物（部署时由 CI 重新构建）
frontend/dist/

# 部署产物（云托管代码包，由 tools/package_server.py 生成，勿入库）
/dist/

# 本地数据库（运行时生成，含种子数据；部署后由新环境自动初始化）
server/data/

# 日志
*.log

# 本地环境变量（保留 .env.example / .env.server / .env.cloud 等构建配置）
.env
.env.local

# 测试覆盖率报告
coverage/
**/coverage/

# WorkBuddy 内部工作数据（记忆/配置，非项目源码，不应入库）
.workbuddy/
# 例外：项目工作记忆随仓库带走（全新克隆不会被覆盖，仅补充本项目笔记）
!.workbuddy/memory/
!.workbuddy/memory/**

# 运行时数据（本地开发库 / 上传附件 / 测试库），不入库
server/data/
server/src/data/

# build/temp artifacts
*.timestamp-*.mjs
feiyue-credit-system*.zip

# PDF build temp
_pdf_tmp/

# Load test scratch space
test_load/

# Optional scripts（保活脚本按需部署，本机默认不需要）
keep_alive.py

# npm 本地缓存
.npmcache/
**/.npmcache/

# 临时调试/测试脚本（_前缀）
_*.py
_*.bat
mktree-*.input

# 小程序图标生成脚本（输出已入库，源脚本不需入库）
miniprogram/make_icons.py

# 微信开发者工具私有配置（含本机路径，不入库）
miniprogram/project.private.config.json

# Windows 保留名（nul 等），Git Bash 会把 nul 当成 NUL 设备但 git status 会报错为 untracked
nul
NUL

# 云托管环境变量文件（含 WX_APP_SECRET 等敏感凭证，已明文，严禁入库）
docs/cloudrun-env.json

# AI 生成的图标候选（根 assets/ 未被 miniprogram 引用，非运行资源）
assets/mp-icons/
assets/mp-icons-v2/
assets/mp-icons-final/

# 提审指引生成脚本（一次性辅助工具，非部署产物）
generate_miniapp_review_guide.py

# 一次性调试快照（沙箱残留）
_*.input
mktree-*.input
_be*.py
_debug_*.py
_diag*.py
_fix_*.py
_run_*.py
_selftest*.*
_st*.py
_st*.bat
_pdf_tmp/
