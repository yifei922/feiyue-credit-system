# ════════════════════════════════════════════════════════════════
# 后端环境变量模板（复制为 .env 并填入真实值；.env 不入库）
# 适用于：本地 Node / Docker / 微信云托管
# ════════════════════════════════════════════════════════════════

# ── 数据库（MySQL / 腾讯云数据库 TencentDB for MySQL）──
# 本地用 docker-compose 起 MySQL 时，host 用 db（compose 服务名），port 3306
# 腾讯云托管：填实例内网/外网地址与账号
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=credit
# 连接池大小（可选，默认 10）
# DB_POOL_SIZE=10
# 启用 SSL（腾讯云公网连接建议开启；内网可关）
# DB_SSL=1
# DB_SSL_VERIFY=0

# ── 微信小程序凭证（Render / Docker / 云托管共用）──
# ⚠️ 必须是「正式个人小程序」后台「开发设置」的 AppID/AppSecret，
#    测试号(sandbox)凭证生产环境真实用户登录会失败！
WX_APP_ID=wxYOURFORMALAPPID
WX_APP_SECRET=your_formal_app_secret

# ── 积分规则 ──
INIT_POINTS=100          # 新用户/存量用户初始赠送积分（前期活动）
RESOURCE_VIEW_COST=5      # 每次查阅/下载资料扣除的积分

# ── JWT 签名密钥（生产必须设置！缺失则服务拒绝启动）──
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_64_char_hex_random_string

# ── 运行环境 ──
# production：关闭微信登录 MOCK、强制真实校验；development：可启用 MOCK
NODE_ENV=production

# ── 可选 ──
# PORT=8080
# TOKEN_EXPIRES=12h
