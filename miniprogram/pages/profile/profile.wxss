.container { padding: 24rpx; min-height: 100vh; background: #f4f5fb; }

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(124,92,255,0.06);
}

.avatar-card { display: flex; flex-direction: column; align-items: center; padding: 48rpx 32rpx; }
.avatar { width: 160rpx; height: 160rpx; border-radius: 50%; border: 4rpx solid #7C5CFF; }
.avatar-tip { margin-top: 20rpx; color: #7C5CFF; font-size: 26rpx; }

.form .field { display: flex; align-items: center; }
.form .label { width: 120rpx; color: #555; font-size: 30rpx; }
.form .input { flex: 1; font-size: 30rpx; padding: 12rpx 0; }
.divider { height: 1rpx; background: #eee; margin: 24rpx 0; }

.hint { color: #888; font-size: 24rpx; line-height: 1.6; }

.save-btn {
  margin-top: 16rpx;
  background: linear-gradient(135deg, #7C5CFF, #4D9BFF);
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
}
.save-btn[disabled] { opacity: 0.6; }
