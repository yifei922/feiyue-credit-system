<view class="container">
  <view class="card avatar-card">
    <image class="avatar" src="{{avatar || '/assets/avatar_default.png'}}" mode="aspectFill" bindtap="onChooseAvatar"></image>
    <view class="avatar-tip" bindtap="onChooseAvatar">{{uploading ? '上传中…' : '点击更换头像'}}</view>
  </view>

  <view class="card form">
    <view class="field">
      <text class="label">姓名</text>
      <input class="input" placeholder="请输入真实姓名" value="{{name}}" bindinput="onName" maxlength="20" />
    </view>
    <view class="divider"></view>
    <view class="field">
      <text class="label">学号</text>
      <input class="input" placeholder="请输入学号（选填）" type="number" value="{{studentId}}" bindinput="onStudentId" />
    </view>
  </view>

  <view class="card hint">
    完善个人资料，方便识别你的记录。资料仅本人和管理员可见。
  </view>

  <button class="save-btn" bindtap="onSave" loading="{{saving}}" disabled="{{saving}}">保存修改</button>
</view>
