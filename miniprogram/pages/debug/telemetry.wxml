<view class="page">
  <view class="cards">
    <view class="card"><view class="num">{{stats.total || 0}}</view><view class="lbl">接口调用</view></view>
    <view class="card"><view class="num {{stats.failRate !== '0%' ? 'bad' : ''}}">{{stats.failRate || '0%'}}</view><view class="lbl">失败率</view></view>
    <view class="card"><view class="num">{{stats.avgMs || 0}}ms</view><view class="lbl">平均耗时</view></view>
    <view class="card"><view class="num">{{stats.p95Ms || 0}}ms</view><view class="lbl">P95 耗时</view></view>
  </view>

  <view class="bar">
    <button class="btn" size="mini" bindtap="onClear">清空</button>
    <button class="btn" size="mini" bindtap="copyJson">复制 JSON</button>
  </view>

  <view class="sec-title">接口明细（最近 50）</view>
  <view wx:if="{{apis.length === 0}}" class="empty">暂无接口调用记录</view>
  <view class="api-item" wx:for="{{apis}}" wx:key="at">
    <text class="api-path">{{item.method}} {{item.path}}</text>
    <text class="api-ms {{item.ok ? '' : 'bad'}}">{{item.ok ? item.ms + 'ms' : 'FAIL ' + item.ms + 'ms'}}</text>
  </view>

  <view class="sec-title">页面曝光（最近 20）</view>
  <view wx:if="{{pages.length === 0}}" class="empty">暂无页面曝光记录</view>
  <view class="page-item" wx:for="{{pages}}" wx:key="at">{{item.route}}</view>
</view>
