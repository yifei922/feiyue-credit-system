/* pages/debug/telemetry.wxss */
.page { padding: 24rpx; background: #f4f5fb; min-height: 100vh; }
.cards { display: flex; gap: 16rpx; }
.card { flex: 1; background: #fff; border-radius: 16rpx; padding: 20rpx; text-align: center; }
.num { font-size: 32rpx; font-weight: 700; color: #333; }
.num.bad { color: #e74c3c; }
.lbl { font-size: 22rpx; color: #999; margin-top: 6rpx; }
.bar { display: flex; gap: 16rpx; margin: 24rpx 0; }
.btn { background: #7C5CFF; color: #fff; font-size: 24rpx; line-height: 56rpx; height: 56rpx; border-radius: 28rpx; margin: 0; }
.sec-title { font-size: 26rpx; color: #666; margin: 24rpx 0 12rpx; font-weight: 600; }
.empty { color: #999; font-size: 24rpx; text-align: center; padding: 32rpx 0; }
.api-item { display: flex; justify-content: space-between; background: #fff; border-radius: 12rpx; padding: 18rpx 22rpx; margin-bottom: 12rpx; }
.api-path { font-size: 24rpx; color: #333; }
.api-ms { font-size: 24rpx; color: #2ecc71; }
.api-ms.bad { color: #e74c3c; }
.page-item { background: #fff; border-radius: 12rpx; padding: 14rpx 22rpx; margin-bottom: 8rpx; font-size: 24rpx; color: #555; }
