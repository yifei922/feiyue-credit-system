/* tasks.wxss - 青春版作业 */
.tab-bar {
  display: flex; background: #fff; border-radius: 24px; padding: 4px; margin-bottom: 12px;
  box-shadow: 0 6px 18px rgba(90,80,200,0.08);
}
.tab {
  flex: 1; text-align: center; padding: 9px 0; border-radius: 20px;
  font-size: 13px; font-weight: 700; color: #7a82a6;
}
.tab.active {
  background: linear-gradient(135deg, #7C5CFF, #4D9BFF); color: #fff;
  box-shadow: 0 6px 16px rgba(124,92,255,0.3);
}
.center { text-align: center; padding: 30px; }

.task-card {
  position: relative; overflow: hidden; transition: all 0.2s;
  border-left: 5px solid #7C5CFF;
}
.task-card:active { transform: scale(0.99); }
.task-card.done { opacity: 0.65; }
.task-card.overdue { border-left: 5px solid #ff5c7c; }

.task-title { font-size: 15.5px; font-weight: 700; margin-bottom: 8px; padding-left: 4px; }
.task-meta { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; padding-left: 4px; }
.task-action { margin-top: 10px; padding-left: 4px; font-size: 13px; font-weight: 700; color: #7C5CFF; }

.badge { font-size: 12px; font-weight: 800; padding: 4px 10px; border-radius: 12px; color: #fff; }
.badge-violet { background: #7C5CFF; }
.badge-mint { background: #2DD4A7; }
.badge-coral { background: #ff5c7c; }
