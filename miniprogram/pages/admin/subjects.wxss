/* pages/admin/subjects.wxss */
.container { padding: 16rpx; background: #f4f5fb; min-height: 100vh; }
.card { background: #fff; border-radius: 20rpx; padding: 24rpx; margin-bottom: 20rpx; }
.sub-item { display: flex; justify-content: space-between; align-items: center; padding: 22rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.sub-item:last-child { border-bottom: none; }
.sub-info { flex: 1; min-width: 0; }
.sub-name { font-size: 30rpx; font-weight: 500; color: #333; }
.sub-meta { font-size: 24rpx; color: #999; margin-top: 4rpx; }
.rep-name { color: #7C5CFF; font-weight: 500; }
.sub-actions { display: flex; gap: 10rpx; align-items: center; flex-shrink: 0; margin-left: 16rpx; }
.action-btn { font-size: 22rpx; padding: 6rpx 16rpx; border-radius: 20rpx; background: #f0f2ff; color: #7C5CFF; }
.action-btn.danger { background: #fff0f0; color: #ff5c7c; }
.action-btn.rep { background: #eef0ff; color: #4D9BFF; border: 1rpx solid #4D9BFF; }
.empty { text-align: center; padding: 100rpx 0; color: #999; font-size: 28rpx; }
.fab { position: fixed; right: 32rpx; bottom: 120rpx; width: 100rpx; height: 100rpx; border-radius: 50%; background: linear-gradient(135deg,#7C5CFF,#4D9BFF); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 48rpx; box-shadow: 0 8rpx 24rpx rgba(124,92,255,.4); z-index: 100; }
.form-group { margin-bottom: 24rpx; }
.form-label { font-size: 26rpx; color: #666; margin-bottom: 10rpx; display: block; }
.form-input { width: 100%; height: 80rpx; line-height: 1.4; border: 2rpx solid #e8e9f0; border-radius: 12rpx; padding: 0 20rpx; font-size: 28rpx; box-sizing: border-box; }
.btn-row { display: flex; gap: 20rpx; margin-top: 32rpx; }
.btn-primary { flex: 1; background: #7C5CFF; color: #fff; border: none; border-radius: 12rpx; padding: 22rpx 0; font-size: 30rpx; }
.btn-cancel { flex: 1; background: #f0f0f0; color: #666; border: none; border-radius: 12rpx; padding: 22rpx 0; font-size: 30rpx; }
.form-title { font-size: 32rpx; font-weight: 600; margin-bottom: 24rpx; }

/* 课代表弹窗 */
.modal-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,.45); z-index: 300; display: flex; align-items: flex-end; }
.modal-card { width: 100%; background: #fff; border-radius: 24rpx 24rpx 0 0; padding: 32rpx; max-height: 70vh; overflow-y: auto; }
.modal-title { font-size: 32rpx; font-weight: 600; margin-bottom: 24rpx; }
.rep-list { display: flex; flex-direction: column; gap: 12rpx; }
.rep-candidate { font-size: 28rpx; padding: 20rpx 24rpx; border-radius: 12rpx; background: #f8f9fc; color: #555; }
.rep-candidate.selected { background: #eef0ff; color: #7C5CFF; font-weight: 600; border: 2rpx solid #7C5CFF; }
.empty-hint { font-size: 24rpx; color: #F5A623; text-align: center; padding: 24rpx; }
