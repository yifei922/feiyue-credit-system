/* pages/admin/tasks.wxss */
.container { padding: 16rpx; background: #f4f5fb; min-height: 100vh; }
.card { background: #fff; border-radius: 20rpx; padding: 24rpx; margin-bottom: 20rpx; }
.filter-bar { display: flex; gap: 12rpx; flex-wrap: wrap; margin-bottom: 20rpx; }
.filter-btn { font-size: 24rpx; padding: 8rpx 20rpx; border-radius: 30rpx; background: #e8e9f0; color: #666; }
.filter-btn.active { background: #7C5CFF; color: #fff; }
.task-item { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.task-item:last-child { border-bottom: none; }
.task-info { flex: 1; }
.task-title { font-size: 30rpx; font-weight: 600; color: #333; margin-bottom: 6rpx; }
.task-meta { font-size: 24rpx; color: #999; display: flex; gap: 16rpx; }
.status-open { color: #4CAF50; }
.status-closed { color: #999; }
.status-draft { color: #FF9800; }
.task-actions { display: flex; flex-direction: column; gap: 8rpx; align-items: flex-end; }
.action-btn { font-size: 22rpx; padding: 6rpx 16rpx; border-radius: 20rpx; background: #f0f2ff; color: #7C5CFF; }
.action-btn.danger { background: #fff0f0; color: #ff5c7c; }
.action-btn.primary { background: #7C5CFF; color: #fff; }
.empty { text-align: center; padding: 100rpx 0; color: #999; font-size: 28rpx; }
.fab { position: fixed; right: 32rpx; bottom: 120rpx; width: 100rpx; height: 100rpx; border-radius: 50%; background: linear-gradient(135deg,#7C5CFF,#4D9BFF); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 48rpx; box-shadow: 0 8rpx 24rpx rgba(124,92,255,.4); z-index: 100; }
.form-title { font-size: 32rpx; font-weight: 600; margin-bottom: 24rpx; }
.form-group { margin-bottom: 24rpx; }
.form-label { font-size: 26rpx; color: #666; margin-bottom: 10rpx; display: block; }
.form-input { width: 100%; height: 80rpx; line-height: 1.4; border: 2rpx solid #e8e9f0; border-radius: 12rpx; padding: 0 20rpx; font-size: 28rpx; box-sizing: border-box; }
.form-textarea { width: 100%; border: 2rpx solid #e8e9f0; border-radius: 12rpx; padding: 18rpx 20rpx; font-size: 28rpx; min-height: 180rpx; line-height: 1.6; box-sizing: border-box; }
.btn-row { display: flex; gap: 20rpx; margin-top: 32rpx; }
.btn-primary { flex: 1; background: #7C5CFF; color: #fff; border: none; border-radius: 12rpx; padding: 22rpx 0; font-size: 30rpx; }
.btn-cancel { flex: 1; background: #f0f0f0; color: #666; border: none; border-radius: 12rpx; padding: 22rpx 0; font-size: 30rpx; }
.subject-tags { display: flex; flex-wrap: wrap; gap: 12rpx; }
.tag { font-size: 24rpx; padding: 8rpx 20rpx; border-radius: 30rpx; background: #e8e9f0; color: #666; }
.tag.selected { background: #7C5CFF; color: #fff; }
.muted { color: #999; font-size: 24rpx; }
.stat-num { font-size: 40rpx; font-weight: 700; color: #7C5CFF; }
.completion-list { margin-top: 16rpx; }
.comp-item { display: flex; justify-content: space-between; align-items: center; padding: 14rpx 0; border-bottom: 1rpx solid #f5f5f5; font-size: 26rpx; }
