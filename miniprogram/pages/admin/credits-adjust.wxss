/* pages/admin/credits-adjust.wxss */
.container { padding: 32rpx; background: #f4f5fb; min-height: 100vh; }
.card { background: #fff; border-radius: 20rpx; padding: 32rpx; margin-bottom: 24rpx; }
.section-title { font-size: 30rpx; font-weight: 600; color: #333; margin-bottom: 20rpx; }
.form-group { margin-bottom: 24rpx; }
.form-label { font-size: 26rpx; color: #666; margin-bottom: 10rpx; display: block; }
.form-input { width: 100%; border: 2rpx solid #e8e9f0; border-radius: 12rpx; padding: 18rpx 20rpx; font-size: 28rpx; box-sizing: border-box; }
.form-textarea { width: 100%; border: 2rpx solid #e8e9f0; border-radius: 12rpx; padding: 18rpx 20rpx; font-size: 28rpx; min-height: 160rpx; box-sizing: border-box; }
.radio-group { display: flex; gap: 24rpx; }
.radio-item { flex: 1; text-align: center; padding: 20rpx; border-radius: 16rpx; border: 2rpx solid #e8e9f0; font-size: 28rpx; }
.radio-item.selected { border-color: #7C5CFF; background: #f5f3ff; color: #7C5CFF; font-weight: 600; }
.btn-primary { width: 100%; background: linear-gradient(135deg,#7C5CFF,#4D9BFF); color: #fff; border: none; border-radius: 16rpx; padding: 24rpx 0; font-size: 32rpx; font-weight: 600; margin-top: 16rpx; }
.btn-primary[disabled] { opacity: .5; }
.tip { font-size: 24rpx; color: #999; line-height: 1.6; margin-top: 16rpx; padding: 16rpx; background: #f8f9fc; border-radius: 12rpx; }
.history { margin-top: 16rpx; }
.hist-item { display: flex; justify-content: space-between; align-items: center; padding: 14rpx 0; border-bottom: 1rpx solid #f5f5f5; font-size: 26rpx; }
.hist-add { color: #4CAF50; font-weight: 600; }
.hist-sub { color: #ff5c7c; font-weight: 600; }
.student-chip { display: inline-block; font-size: 22rpx; padding: 6rpx 16rpx; border-radius: 20rpx; background: #f0f2ff; color: #7C5CFF; margin: 4rpx 4rpx 4rpx 0; }
