/* pages/admin/alerts.wxss - 预警中心 */
.container { padding: 20rpx; background: #f4f5fb; min-height: 100vh; }
.tabs { display: flex; gap: 12rpx; margin-bottom: 16rpx; flex-wrap: wrap; align-items: center; }
.tab { font-size: 24rpx; padding: 12rpx 24rpx; border-radius: 30rpx; background: #fff; color: #666; }
.tab.active { background: linear-gradient(135deg,#7C5CFF,#4D9BFF); color: #fff; }
.scan-btn { font-size: 22rpx; padding: 10rpx 20rpx; border-radius: 30rpx; background: #fff3e0; color: #F5A623; margin-left: auto; }
.scan-btn.scanning { opacity: .6; }

.card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; }
.alert-item { border-left: 6rpx solid #FF7043; }
.alert-header { display: flex; align-items: center; gap: 12rpx; margin-bottom: 10rpx; }
.alert-student { font-size: 30rpx; font-weight: 600; color: #333; }
.alert-type { font-size: 20rpx; padding: 3rpx 12rpx; border-radius: 8rpx; font-weight: 500; }
.type-CONSECUTIVE_MISS { background: #FFF3E0; color: #E65100; }
.type-OVERDUE_SOON { background: #E3F2FD; color: #1565C0; }
.alert-status { font-size: 20rpx; padding: 3rpx 12rpx; border-radius: 8rpx; margin-left: auto; }
.status-PENDING { background: #FFEBEE; color: #C62828; }
.status-RESOLVED { background: #E8F5E9; color: #2E7D32; }
.alert-reason { font-size: 26rpx; color: #555; line-height: 1.5; margin-bottom: 8rpx; }
.alert-meta { font-size: 22rpx; color: #bbb; }
.resolve-btn { margin-top: 14rpx; text-align: right; font-size: 26rpx; color: #4CAF50; font-weight: 600; }
.empty { text-align: center; color: #aaa; padding: 100rpx 0; font-size: 26rpx; }
