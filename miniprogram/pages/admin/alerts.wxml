<view class="container">
  <!-- 筛选 tab -->
  <view class="tabs">
    <view wx:for="{{STATUS_TABS}}" wx:key="value"
          class="tab {{statusFilter===item.value?'active':''}}"
          data-value="{{item.value}}" bindtap="onTab">{{item.label}}</view>
    <view class="scan-btn {{scanning?'scanning':''}}" bindtap="onScan">
      {{scanning ? '扫描中…' : '🔍 扫描'}}
    </view>
  </view>

  <view wx:if="{{loading && !alerts.length}}" class="empty">加载中…</view>
  <view wx:elif="{{!alerts.length}}" class="empty">暂无预警记录</view>

  <view wx:for="{{alerts}}" wx:key="id" class="card alert-item">
    <view class="alert-header">
      <view class="alert-student">{{item.studentName || '—'}}</view>
      <view class="alert-type type-{{item.type}}">{{item.typeText || item.type}}</view>
      <view class="alert-status status-{{item.status}}">{{item.status==='PENDING'?'待处理':'已解决'}}</view>
    </view>
    <view class="alert-reason">{{item.reason}}</view>
    <view class="alert-meta">{{item.createTime || ''}}</view>
    <view wx:if="{{item.status==='PENDING'}}" class="resolve-btn" data-id="{{item.id}}" bindtap="onResolve">标记解决</view>
  </view>
</view>
