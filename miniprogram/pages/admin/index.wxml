<view class="container">
  <view class="banner">
    <view class="role-badge">{{roleLabel}}工作台</view>
    <view class="banner-sub">管理中心</view>
  </view>

  <!-- 统计概览（对标网页端 Dashboard 顶部卡片） -->
  <view class="stats card">
    <view class="stat"><view class="num">{{stats.students || 0}}</view><view class="lbl">圈内成员</view></view>
    <view class="stat"><view class="num">{{stats.tasks || 0}}</view><view class="lbl">本学期任务</view></view>
    <view class="stat"><view class="num">{{stats.avgCredits || 0}}</view><view class="lbl">平均积分</view></view>
    <view class="stat"><view class="num">{{stats.todayActive || 0}}</view><view class="lbl">今日活跃</view></view>
  </view>

  <!-- 核心管理功能（对标网页端 MainLayout 菜单顺序） -->
  <view class="section-title">教学管理</view>
  <view class="menu card">
    <!-- 1. 任务/打卡任务管理（对标 /tasks） -->
    <view class="menu-item" bindtap="goTasks">
      <view class="ico" style="background:linear-gradient(135deg,#7C5CFF,#4D9BFF)">📋</view>
      <view class="mi-text"><view class="mi-title">任务管理</view><view class="mi-sub">发布打卡任务、查看完成情况、登记积分</view></view>
      <text class="muted">›</text>
    </view>

    <!-- 2. 完成登记（对标 /completion，合并到任务管理的完成情况弹窗） -->
    <view class="menu-item" bindtap="goTasks">
      <view class="ico" style="background:linear-gradient(135deg,#2DD4A7,#00BFA5)">✅</view>
      <view class="mi-text"><view class="mi-title">完成登记</view><view class="mi-sub">批量登记成员打卡完成状态</view></view>
      <text class="muted">›</text>
    </view>

    <!-- 3. 成员管理（对标 /manage） -->
    <view wx:if="{{canManageUsers}}" class="menu-item" bindtap="goStudents">
      <view class="ico" style="background:linear-gradient(135deg,#2DD4A7,#4D9BFF)">👥</view>
      <view class="mi-text"><view class="mi-title">成员管理</view><view class="mi-sub">添加/编辑成员、重置密码、积分调整</view></view>
      <text class="muted">›</text>
    </view>

    <!-- 4. 兴趣分类管理（对标 SystemSettings → 小组长任命） -->
    <view wx:if="{{canManageUsers}}" class="menu-item" bindtap="goSubjects">
      <view class="ico" style="background:linear-gradient(135deg,#FFB74D,#FF8A65)">📚</view>
      <view class="mi-text"><view class="mi-title">兴趣分类与小组长</view><view class="mi-sub">管理兴趣分类、指定小组长负责兴趣分类</view></view>
      <text class="muted">›</text>
    </view>

    <!-- 5. 资料管理（对标 /resources） -->
    <view class="menu-item" bindtap="goResources">
      <view class="ico" style="background:linear-gradient(135deg,#7C5CFF,#9C27B0)">📖</view>
      <view class="mi-text"><view class="mi-title">资料管理</view><view class="mi-sub">新增/编辑/删除兴趣资料</view></view>
      <text class="muted">›</text>
    </view>
  </view>

  <view class="section-title">系统管理</view>
  <view class="menu card">
    <!-- 6. 账号管理（对标 SystemSettings → 账号管理） -->
    <view wx:if="{{canManageUsers}}" class="menu-item" bindtap="goUsers">
      <view class="ico" style="background:linear-gradient(135deg,#BA68C8,#9C27B0)">🔐</view>
      <view class="mi-text"><view class="mi-title">账号管理</view><view class="mi-sub">查看账号、重置密码、修改角色</view></view>
      <text class="muted">›</text>
    </view>

    <!-- 7. 积分调整（对标 StudentManage 内嵌功能） -->
    <view class="menu-item" bindtap="goCreditsAdjust">
      <view class="ico" style="background:linear-gradient(135deg,#FF7EB3,#FF758C)">⚖️</view>
      <view class="mi-text"><view class="mi-title">积分调整</view><view class="mi-sub">手动加减分、记录原因</view></view>
      <text class="muted">›</text>
    </view>

    <!-- 8. 积分流水（对标 StudentPortal → 积分流水 Tab） -->
    <view class="menu-item" bindtap="goCredits">
      <view class="ico" style="background:linear-gradient(135deg,#4FC3F7,#29B6F6)">📊</view>
      <view class="mi-text"><view class="mi-title">积分流水</view><view class="mi-sub">查看全部积分变动记录</view></view>
      <text class="muted">›</text>
    </view>

    <!-- 9. 预警中心（对标 /alerts，新增） -->
    <view class="menu-item" bindtap="goAlerts">
      <view class="ico" style="background:linear-gradient(135deg,#FF7043,#F4511E)">⚠️</view>
      <view class="mi-text"><view class="mi-title">预警中心</view><view class="mi-sub">连续未完成/临近截止预警、标记解决</view></view>
      <text class="muted">›</text>
    </view>

    <!-- 10. 操作日志（对标 SystemSettings → 操作日志 Tab，新增） -->
    <view class="menu-item" bindtap="goOperateLog">
      <view class="ico" style="background:linear-gradient(135deg,#90A4AE,#607D8B)">📝</view>
      <view class="mi-text"><view class="mi-title">操作日志</view><view class="mi-sub">查看所有操作记录与变更快照</view></view>
      <text class="muted">›</text>
    </view>

    <!-- 11. 举报处理（合规闭环：用户举报的违规动态） -->
    <view class="menu-item" bindtap="goReports">
      <view class="ico" style="background:linear-gradient(135deg,#E57373,#C5204F)">🚩</view>
      <view class="mi-text"><view class="mi-title">举报处理</view><view class="mi-sub">查看用户举报的违规动态并处理</view></view>
      <text class="muted">›</text>
    </view>
  </view>

  <view class="footer muted">操作会记录日志 · 请妥善使用</view>
</view>
