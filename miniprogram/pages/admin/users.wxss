.container { padding: 24rpx; min-height: 100vh; background: #f4f5fb; }
.tabs { display: flex; gap: 12rpx; margin-bottom: 16rpx; flex-wrap: wrap; }
.tab { font-size: 24rpx; padding: 12rpx 24rpx; border-radius: 30rpx; background: #fff; color: #666; }
.tab.active { background: linear-gradient(135deg,#7C5CFF,#4D9BFF); color: #fff; }

.empty { text-align: center; color: #aaa; padding: 80rpx 0; font-size: 26rpx; }

.item { display: flex; align-items: center; justify-content: space-between; padding: 24rpx; margin-bottom: 16rpx; }
.name { font-size: 30rpx; font-weight: 600; color: #333; }
.role { font-size: 20rpx; color: #7C5CFF; background: #eef0ff; padding: 2rpx 10rpx; border-radius: 8rpx; margin-left: 8rpx; font-weight: 400; }
.meta { font-size: 24rpx; color: #888; margin-top: 8rpx; }
.reset { font-size: 24rpx; color: #4D9BFF; border: 1rpx solid #4D9BFF; border-radius: 30rpx; padding: 10rpx 20rpx; }
