.container { padding: 24rpx; min-height: 100vh; background: #f4f5fb; }
.tabs { display: flex; gap: 12rpx; margin-bottom: 16rpx; flex-wrap: wrap; }
.tab { font-size: 24rpx; padding: 12rpx 24rpx; border-radius: 30rpx; background: #fff; color: #666; }
.tab.active { background: linear-gradient(135deg,#7C5CFF,#4D9BFF); color: #fff; }

.empty { text-align: center; color: #aaa; padding: 80rpx 0; font-size: 26rpx; }

.item { display: flex; align-items: center; justify-content: space-between; padding: 24rpx; margin-bottom: 16rpx; }
.item-main { flex: 1; min-width: 0; }
.name { font-size: 30rpx; font-weight: 600; color: #333; }
.role { font-size: 20rpx; color: #7C5CFF; background: #eef0ff; padding: 2rpx 10rpx; border-radius: 8rpx; margin-left: 8rpx; font-weight: 400; }
.meta { font-size: 24rpx; color: #888; margin-top: 8rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.actions { display: flex; gap: 10rpx; margin-left: 16rpx; flex-shrink: 0; }
.action-btn { font-size: 22rpx; padding: 8rpx 18rpx; border-radius: 30rpx; }
.action-btn.reset { color: #4D9BFF; border: 1rpx solid #4D9BFF; }
.action-btn.role { color: #9C27B0; border: 1rpx solid #9C27B0; }

/* 角色编辑弹窗 */
.modal-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,.45); z-index: 300; display: flex; align-items: flex-end; }
.modal-card { width: 100%; background: #fff; border-radius: 24rpx 24rpx 0 0; padding: 32rpx; max-height: 80vh; overflow-y: auto; }
.modal-title { font-size: 32rpx; font-weight: 600; margin-bottom: 24rpx; }
.form-group { margin-bottom: 24rpx; }
.form-label { font-size: 26rpx; color: #666; margin-bottom: 12rpx; display: block; }
.role-options { display: flex; gap: 14rpx; flex-wrap: wrap; }
.role-opt { font-size: 26rpx; padding: 14rpx 28rpx; border-radius: 30rpx; background: #f5f5f5; color: #666; }
.role-opt.selected { background: #7C5CFF; color: #fff; }
.subject-tags { display: flex; flex-wrap: wrap; gap: 12rpx; }
.tag { font-size: 24rpx; padding: 10rpx 22rpx; border-radius: 30rpx; background: #f0f2ff; color: #7C5CFF; }
.tag.selected { background: #7C5CFF; color: #fff; }
.warn-hint { font-size: 22rpx; color: #F5A623; margin-top: 8rpx; }
.btn-row { display: flex; gap: 20rpx; margin-top: 8rpx; }
.btn-primary { flex: 1; background: linear-gradient(135deg,#7C5CFF,#4D9BFF); color: #fff; border: none; border-radius: 12rpx; padding: 22rpx 0; font-size: 30rpx; }
.btn-cancel { flex: 1; background: #f0f0f0; color: #666; border: none; border-radius: 12rpx; padding: 22rpx 0; font-size: 30rpx; }
