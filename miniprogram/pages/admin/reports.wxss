/* pages/admin/reports.wxss - 举报管理样式 */
.container { padding: 24rpx; }
.top-bar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }
.title { font-size: 32rpx; font-weight: 600; color: #1f2330; }
.empty { text-align: center; color: #b9bfd6; padding: 80rpx 0; font-size: 28rpx; }
.item { margin-bottom: 24rpx; }
.row1 { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.row2 { font-size: 26rpx; color: #4b5168; margin-bottom: 8rpx; }
.row3 { font-size: 26rpx; color: #7a8194; margin-top: 8rpx; padding-top: 12rpx; border-top: 1rpx dashed #eef0ff; }
.tag.danger { background: #ffe4ec; color: #c5204f; padding: 4rpx 16rpx; border-radius: 16rpx; font-size: 22rpx; }
.tag.muted { color: #b9bfd6; font-size: 22rpx; }
.item-ops { display: flex; gap: 24rpx; margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid #f4f5fb; }
.op { font-size: 26rpx; padding: 6rpx 16rpx; border-radius: 8rpx; }
.op.view { color: #7C5CFF; background: #eef0ff; }
.op.del { color: #c5204f; background: #ffe4ec; }
.op.ok { color: #2DD4A7; background: #e6f8f1; }