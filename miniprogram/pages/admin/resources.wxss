.container { padding: 24rpx; min-height: 100vh; background: #f4f5fb; }
.top-bar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.title { font-size: 30rpx; font-weight: 600; color: #333; }
.add-btn { background: linear-gradient(135deg,#7C5CFF,#4D9BFF); color: #fff; border-radius: 30rpx; }

.empty { text-align: center; color: #aaa; padding: 80rpx 0; font-size: 26rpx; }

.item { display: flex; align-items: center; justify-content: space-between; padding: 24rpx; margin-bottom: 16rpx; }
.item-title { font-size: 30rpx; color: #333; font-weight: 500; }
.item-meta { margin-top: 10rpx; }
.tag { font-size: 20rpx; padding: 4rpx 12rpx; border-radius: 8rpx; margin-right: 10rpx; }
.tag.grade { background: #eef0ff; color: #7C5CFF; }
.tag.subject { background: #e6f8f1; color: #2DD4A7; }
.tag.type { background: #fdeef4; color: #FF758C; }

.item-ops { display: flex; flex-direction: column; }
.op { font-size: 26rpx; padding: 8rpx 16rpx; text-align: center; }
.op.edit { color: #4D9BFF; }
.op.del { color: #ff5c7c; margin-top: 8rpx; }

.mask { position: fixed; inset: 0; background: rgba(0,0,0,0.45); display: flex; align-items: flex-end; z-index: 10; }
.sheet { width: 100%; background: #fff; border-radius: 24rpx 24rpx 0 0; padding: 32rpx; max-height: 84vh; display: flex; flex-direction: column; }
.sheet-title { font-size: 32rpx; font-weight: 700; text-align: center; margin-bottom: 24rpx; }
.sheet-body { flex: 1; }
.form-item { margin-bottom: 24rpx; }
.fl { font-size: 26rpx; color: #666; display: block; margin-bottom: 10rpx; }
.fi { border: 1rpx solid #e5e5ef; border-radius: 12rpx; padding: 18rpx; font-size: 28rpx; width: 100%; box-sizing: border-box; }
.ta { height: 140rpx; }
.picker { border: 1rpx solid #e5e5ef; border-radius: 12rpx; padding: 18rpx; font-size: 28rpx; color: #333; }
.sheet-ops { display: flex; gap: 20rpx; margin-top: 16rpx; }
.cancel { flex: 1; background: #f0f0f5; color: #666; border-radius: 40rpx; }
.ok { flex: 1; background: linear-gradient(135deg,#7C5CFF,#4D9BFF); color: #fff; border-radius: 40rpx; }
