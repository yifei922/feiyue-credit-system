/* pages/admin/operate-log.wxss */
.page { padding: 20rpx 24rpx 40rpx; min-height: 100vh; background: #f5f6fa; }
.filters { display: flex; align-items: center; gap: 14rpx; margin-bottom: 20rpx; }
.search-input { flex: 1; border: 2rpx solid #e8e9f0; border-radius: 30rpx; padding: 14rpx 24rpx; font-size: 26rpx; background: #fff; }
.type-picker { background: #fff; border: 2rpx solid #e8e9f0; border-radius: 30rpx; padding: 14rpx 22rpx; font-size: 26rpx; }
.picker-display { color: #333; }
.btn-mini { background: #4b7bec; color: #fff; font-size: 24rpx; padding: 0 20rpx; line-height: 56rpx; height: 56rpx; border-radius: 28rpx; margin: 0; }

.loading, .empty { text-align: center; color: #999; font-size: 26rpx; padding: 80rpx 0; }
.date-filters { margin-top: 0; }
.date-picker { background: #fff; border: 2rpx solid #e8e9f0; border-radius: 30rpx; padding: 14rpx 22rpx; font-size: 26rpx; color: #333; }
.date-sep { color: #999; font-size: 24rpx; }
.error-bar { background: #fff0f0; color: #e74c3c; font-size: 24rpx; padding: 16rpx 24rpx; border-radius: 12rpx; margin-bottom: 16rpx; text-align: center; }
.load-more { text-align: center; color: #4b7bec; font-size: 26rpx; padding: 24rpx 0 60rpx; }

.list { display: flex; flex-direction: column; gap: 18rpx; }
.log-card { background: #fff; border-radius: 16rpx; padding: 24rpx; box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.04); }
.log-head { display: flex; align-items: center; gap: 14rpx; }
.op-name { font-size: 30rpx; font-weight: 600; color: #222; }
.op-tag { font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 20rpx; color: #fff; }
.op-CREATE { background: #2ecc71; }
.op-UPDATE { background: #4b7bec; }
.op-DELETE { background: #e74c3c; }
.op-LOGIN { background: #95a5a6; }
.op-RESET_PASSWORD { background: #f39c12; }
.op-ADJUST { background: #9b59b6; }
.op-ROLE { background: #16a085; }
.op-time { margin-left: auto; font-size: 24rpx; color: #aaa; }
.log-body { display: flex; align-items: center; gap: 14rpx; margin-top: 12rpx; }
.op-table { font-size: 26rpx; color: #555; background: #f0f2f8; padding: 4rpx 14rpx; border-radius: 8rpx; }
.op-record { font-size: 26rpx; color: #888; }
.log-foot { margin-top: 14rpx; font-size: 24rpx; color: #4b7bec; }

/* 弹窗 */
.modal-mask { position: fixed; inset: 0; background: rgba(0,0,0,0.45); display: flex; align-items: center; justify-content: center; z-index: 100; }
.modal { width: 86%; max-height: 80vh; overflow-y: auto; background: #fff; border-radius: 20rpx; padding: 32rpx; }
.modal-title { font-size: 32rpx; font-weight: 700; text-align: center; margin-bottom: 24rpx; color: #222; }
.snap-row { display: flex; font-size: 26rpx; padding: 8rpx 0; border-bottom: 1rpx solid #f0f2f8; }
.snap-k { width: 140rpx; color: #999; flex-shrink: 0; }
.snap-v { flex: 1; color: #333; word-break: break-all; }
.snap-block { margin-top: 18rpx; }
.snap-label { font-size: 24rpx; color: #888; margin-bottom: 8rpx; }
.snap-code { font-size: 22rpx; line-height: 1.5; background: #f7f8fa; border-radius: 8rpx; padding: 14rpx; color: #444; white-space: pre-wrap; word-break: break-all; }
.btn-close { margin-top: 28rpx; background: #4b7bec; color: #fff; font-size: 28rpx; border-radius: 30rpx; }
