.me-card {
  display: flex; align-items: center;
  background: #fff; border-radius: 12px; padding: 16px;
  margin-bottom: 12px;
  box-shadow: 0 4px 16px rgba(31,41,55,0.04);
}
.avatar { width: 60px; height: 60px; border-radius: 50%; background: #eef0f4; margin-right: 14px; }
.name { font-size: 18px; font-weight: 600; }
.role { font-size: 13px; margin-top: 2px; }

.row { display: flex; padding: 16px 0; }
.row-item { flex: 1; text-align: center; }
.big-num { font-size: 20px; font-weight: 700; color: #c8102e; }

.menu { padding: 0 16px; }
.menu-item {
  display: flex; align-items: center; gap: 12px;
  padding: 14px 0;
  border-bottom: 1px solid #eef0f4;
}
.menu-item:last-child { border-bottom: none; }
.ico { font-size: 18px; }
.spacer { flex: 1; text-align: right; font-size: 18px; }

.footer { text-align: center; padding: 24px 0; font-size: 11px; }