<view class="container">
  <view class="me-card">
    <image class="avatar" src="{{user.avatar || '/assets/avatar_default.png'}}"></image>
    <view class="me-info">
      <view class="name">{{user.name}}</view>
      <view class="role muted">{{user.role === 'STUDENT' ? '学生' : user.role === 'TEACHER' ? '教师' : user.role === 'REP' ? '科代' : '其他'}}</view>
    </view>
  </view>

  <view class="row card">
    <view class="row-item" bindtap="goCredits">
      <view class="big-num">{{credits.length || '--'}}</view>
      <view class="muted">学分明细</view>
    </view>
    <view class="row-item">
      <view class="big-num">{{points}}</view>
      <view class="muted">积分余额</view>
    </view>
    <view class="row-item">
      <view class="big-num">{{totalEarned}}</view>
      <view class="muted">累计赚取</view>
    </view>
  </view>

  <view class="menu card">
    <view class="menu-item" bindtap="goPublish">
      <text class="ico">📝</text>
      <text>发动态</text>
      <text class="muted spacer">›</text>
    </view>
    <view class="menu-item" bindtap="goCredits">
      <text class="ico">📊</text>
      <text>学分流水</text>
      <text class="muted spacer">›</text>
    </view>
    <view class="menu-item" bindtap="onLogout">
      <text class="ico">🚪</text>
      <text class="danger">退出登录</text>
      <text class="muted spacer">›</text>
    </view>
  </view>

  <view class="footer muted">斐越科技 出品 · 班级学分管理小程序 v1.0</view>
</view>