/* pages/me/change-pwd.wxss */
.page { padding: 32rpx; background: #f4f5fb; min-height: 100vh; }
.banner { background: #fff8e1; color: #F5A623; font-size: 26rpx; padding: 20rpx 24rpx; border-radius: 12rpx; margin-bottom: 28rpx; }
.form { background: #fff; border-radius: 20rpx; padding: 32rpx; }
.form-group { margin-bottom: 28rpx; }
.form-label { font-size: 26rpx; color: #666; margin-bottom: 12rpx; display: block; }
.form-input { width: 100%; height: 80rpx; line-height: 1.4; border: 2rpx solid #e8e9f0; border-radius: 12rpx; padding: 0 20rpx; font-size: 28rpx; box-sizing: border-box; }
.error { color: #e74c3c; font-size: 24rpx; margin: 8rpx 0 20rpx; }
.btn-primary { background: #7C5CFF; color: #fff; border: none; border-radius: 12rpx; padding: 24rpx 0; font-size: 30rpx; margin-top: 12rpx; }
