.post-head { display: flex; align-items: center; margin-bottom: 10px; }
.post-avatar { width: 40px; height: 40px; border-radius: 50%; background: #eef0f4; margin-right: 10px; }
.post-name { font-size: 14px; font-weight: 600; }
.post-time { font-size: 11px; }
.post-text { font-size: 15px; line-height: 1.6; }
.comments-title { font-weight: 600; margin-bottom: 12px; }
.comment { padding: 8px 0; border-bottom: 1px solid #eef0f4; }
.comment:last-child { border-bottom: none; }
.comment-text { font-size: 14px; margin: 4px 0; }
.center { text-align: center; padding: 20px; }
.comment-input { display: flex; align-items: center; gap: 8px; }
.comment-input input { flex: 1; padding: 6px; }
.btn-primary { background: linear-gradient(135deg, #7C5CFF, #4D9BFF); color: #fff; border-radius: 18px; padding: 8px 16px; font-size: 13px; box-shadow: 0 6px 16px rgba(124,92,255,0.3); }
.pub-area { width: 100%; min-height: 160px; padding: 10px; font-size: 15px; }
.pub-btn { margin-top: 12px; width: 100%; }