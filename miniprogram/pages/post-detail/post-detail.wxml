<view class="container">
  <!-- 发布模式 -->
  <block wx:if="{{mode === 'publish'}}">
    <view class="card">
      <textarea class="pub-area" placeholder="说点什么吧…" maxlength="1000" bindinput="onPublishText"></textarea>
      <button class="btn-primary pub-btn" bindtap="onPubSubmit">发布</button>
    </view>
  </block>

  <!-- 详情模式 -->
  <block wx:else>
    <view wx:if="{{post}}" class="card">
      <view class="post-head">
        <image class="post-avatar" src="{{post.user_avatar || '/assets/avatar_default.png'}}"></image>
        <view>
          <view class="post-name">{{post.user_name}}</view>
          <view class="muted post-time">{{post.created_at}}</view>
        </view>
      </view>
      <view wx:if="{{post.text}}" class="post-text">{{post.text}}</view>
    </view>

    <view class="card">
      <view class="comments-title">💬 评论 ({{comments.length}})</view>
      <view wx:if="{{comments.length === 0}}" class="muted center">还没有评论</view>
      <view wx:for="{{comments}}" wx:key="id" class="comment">
        <view class="post-name">{{item.user_name}}</view>
        <view class="comment-text">{{item.text}}</view>
        <view class="muted">{{item.created_at}}</view>
      </view>
    </view>

    <view class="comment-input card">
      <input placeholder="写评论…" value="{{text}}" bindinput="onTextInput" />
      <button class="btn-primary" bindtap="onSubmit">发送</button>
    </view>
  </block>
</view>