.login-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(160deg, #7C5CFF 0%, #4D9BFF 55%, #2DD4A7 100%);
  padding: 24px;
}
.login-card {
  width: 100%;
  max-width: 420px;
  background: #fff;
  border-radius: 16px;
  padding: 32px 24px 24px;
  box-shadow: 0 12px 40px rgba(31, 41, 55, 0.1);
}
.brand {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 16px;
}
.logo-img {
  width: 52px;
  height: 52px;
  border-radius: 12px;
}
.title { font-size: 18px; font-weight: 600; color: #1f2937; }
.subtitle { font-size: 12px; color: #8893ad; }
.powered-by {
  text-align: center;
  font-size: 11px;
  color: #c0bfc0;
  letter-spacing: 1px;
  margin-bottom: 18px;
}
.wx-login {
  background: #07c160;
  color: #fff;
  border-radius: 24px;
  font-size: 16px;
}
.divider-or {
  text-align: center;
  font-size: 12px;
  color: #8893ad;
  margin: 16px 0 12px;
}
.form-block { padding-top: 4px; }
.input-row {
  display: flex;
  align-items: center;
  border-bottom: 1px solid #eef0f4;
  margin-bottom: 14px;
  padding: 6px 0;
}
.input-label { color: #5b6478; font-size: 13px; width: 56px; }
.input { flex: 1; font-size: 14px; padding: 6px 0; }
.eye { padding: 0 8px; color: #8893ad; }
.btn-ghost {
  margin-top: 8px;
  width: 100%;
  background: #fff;
  color: #7C5CFF;
  border: 1.5px solid #7C5CFF;
  border-radius: 24px;
  font-weight: 600;
}
.cold-hint {
  margin-top: 12px;
  padding: 8px 12px;
  background: #fff7e6;
  border-radius: 8px;
  font-size: 12px;
  color: #b35900;
  text-align: center;
}
.bottom-hint { margin-top: 16px; text-align: center; font-size: 12px; }
.bottom-warn {
  margin-top: 8px;
  padding: 8px 10px;
  background: #f6f8ff;
  border-radius: 8px;
  text-align: left;
  font-size: 11px;
}