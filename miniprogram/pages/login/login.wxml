<view class="login-page">
  <view class="login-card">
    <view class="brand">
      <image src="/assets/logo.jpg" class="logo-img" mode="aspectFit" binderror="onLogoError"></image>
      <view>
        <view class="title">点滴进步</view>
        <view class="subtitle">记录每天的小进步</view>
      </view>
    </view>

    <view class="powered-by">个人开发者作品</view>

    <!-- 微信一键登录 -->
    <button class="btn-primary wx-login" bindtap="onWxLogin" loading="{{loading}}">
      📱 微信一键登录
    </button>

    <view class="divider-or">—— 或使用账号密码 ——</view>

    <view class="form-block">
      <view class="input-row">
        <text class="input-label">用户名</text>
        <input class="input" placeholder="请输入用户名" value="{{username}}" bindinput="onUserInput" />
      </view>
      <view class="input-row">
        <text class="input-label">密码</text>
        <input class="input" password="{{!showPwd}}" placeholder="请输入密码" value="{{password}}" bindinput="onPwdInput" />
        <view class="eye" bindtap="togglePwd">{{showPwd ? '🙈' : '👁'}}</view>
      </view>
      <button class="btn-ghost" bindtap="onPwdLogin" loading="{{loading}}">登 录</button>
    </view>
  </view>
</view>