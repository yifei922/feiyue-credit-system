.publish-fab {
  position: fixed;
  right: 20px;
  bottom: 110px;
  width: 52px; height: 52px;
  border-radius: 50%;
  background: #c8102e;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 6px 20px rgba(200,16,46,0.3);
  z-index: 10;
}
.plus { color: #fff; font-size: 30px; font-weight: 300; }
.center { text-align: center; padding: 30px; }

.post { padding: 14px; }
.post-head { display: flex; align-items: center; margin-bottom: 8px; }
.post-avatar { width: 40px; height: 40px; border-radius: 50%; background: #eef0f4; margin-right: 10px; }
.post-name { font-size: 14px; font-weight: 600; }
.post-time { font-size: 11px; }
.post-text { font-size: 14px; line-height: 1.6; margin: 6px 0; }
.post-images { display: flex; gap: 4px; flex-wrap: wrap; margin-top: 6px; }
.post-img { width: calc(33.33% - 3px); aspect-ratio: 1/1; border-radius: 4px; background: #eef0f4; }
.post-actions { display: flex; gap: 24px; padding-top: 10px; margin-top: 6px; border-top: 1px solid #eef0f4; }
.action { display: flex; align-items: center; gap: 6px; }
.ico { font-size: 18px; color: #8893ad; }
.ico.liked { color: #c8102e; }