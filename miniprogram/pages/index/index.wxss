/* index.wxss - 青春版首页 */
.user-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #7C5CFF 0%, #4D9BFF 100%);
  color: #fff;
  border-radius: 22px;
  padding: 18px 16px;
  margin-bottom: 16px;
  position: relative;
  overflow: hidden;
  box-shadow: 0 12px 30px rgba(124,92,255,0.28);
}
.user-card::after {
  content: "";
  position: absolute; width: 150px; height: 150px; right: -50px; top: -60px;
  background: radial-gradient(circle, rgba(255,255,255,0.22), transparent 70%);
}
.avatar {
  width: 56px; height: 56px; border-radius: 50%;
  background: #fff; margin-right: 14px; flex: 0 0 56px;
  display: flex; align-items: center; justify-content: center; font-size: 26px;
}
.user-info { flex: 1; z-index: 1; }
.name { font-size: 18px; font-weight: 800; }
.role { font-size: 13px; opacity: 0.92; margin-top: 2px; }
.credit-block {
  text-align: center; padding-left: 14px;
  border-left: 1px solid rgba(255,255,255,0.3); z-index: 1;
}
.credit-label { font-size: 11px; opacity: 0.9; }
.credit-num { font-size: 22px; font-weight: 800; }

.quick-row {
  display: flex; gap: 10px; margin-bottom: 16px;
}
.quick-item {
  flex: 1; background: #fff; border-radius: 18px; padding: 14px 4px;
  text-align: center; box-shadow: 0 6px 18px rgba(90,80,200,0.08);
}
.quick-ico {
  width: 46px; height: 46px; border-radius: 15px; margin: 0 auto 8px;
  display: flex; align-items: center; justify-content: center; font-size: 24px; color: #fff;
}
.quick-text { font-size: 12.5px; font-weight: 600; color: #1b1f3b; }

.grade-bar {
  display: flex; background: #fff; border-radius: 24px; padding: 4px;
  margin-bottom: 12px; box-shadow: 0 6px 18px rgba(90,80,200,0.08);
}
.grade-tab {
  flex: 1; text-align: center; padding: 9px 0; border-radius: 20px;
  font-size: 14px; font-weight: 600; color: #7a82a6;
}
.grade-tab.active {
  background: linear-gradient(135deg, #7C5CFF, #4D9BFF);
  color: #fff; box-shadow: 0 6px 16px rgba(124,92,255,0.35);
}

.section-title {
  font-size: 16px; font-weight: 800; margin: 16px 4px 10px;
}
.center { text-align: center; padding: 20px; }

.res-grid { display: flex; flex-wrap: wrap; gap: 12px; }
.res-card {
  width: calc(50% - 6px); background: #fff; border-radius: 18px;
  overflow: hidden; box-shadow: 0 6px 18px rgba(90,80,200,0.08);
}
.res-cover {
  height: 92px; display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: 30px; position: relative;
}
.res-cover .sub-tag {
  position: absolute; left: 10px; top: 8px; font-size: 11px; font-weight: 600;
  background: rgba(0,0,0,0.2); padding: 2px 8px; border-radius: 10px;
}
.cover-text { text-shadow: 0 2px 8px rgba(0,0,0,0.2); }
.res-title {
  font-size: 13.5px; font-weight: 600; padding: 9px 11px 4px; line-height: 1.4;
  height: 38px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
}
.res-meta {
  display: flex; justify-content: space-between; align-items: center;
  padding: 0 11px 10px; font-size: 11px; color: #7a82a6;
}
