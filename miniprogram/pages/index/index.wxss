.user-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #c8102e, #e85d68);
  color: #fff;
  border-radius: 16px;
  padding: 18px 16px;
  margin-bottom: 16px;
  box-shadow: 0 6px 20px rgba(200,16,46,0.15);
}
.avatar {
  width: 56px; height: 56px;
  border-radius: 50%;
  background: #fff;
  margin-right: 14px;
}
.user-info { flex: 1; }
.name { font-size: 18px; font-weight: 600; }
.role { font-size: 13px; opacity: 0.9; }
.credit-block {
  text-align: center;
  padding-left: 14px;
  border-left: 1px solid rgba(255,255,255,0.3);
}
.credit-label { font-size: 11px; opacity: 0.9; }
.credit-num { font-size: 22px; font-weight: 700; }

.quick-row {
  display: flex;
  background: #fff;
  border-radius: 12px;
  padding: 14px 0;
  margin-bottom: 16px;
  box-shadow: 0 4px 16px rgba(31,41,55,0.04);
}
.quick-item { flex: 1; text-align: center; }
.quick-ico { font-size: 24px; }
.quick-text { font-size: 12px; color: #5b6478; margin-top: 4px; }

.grade-bar {
  display: flex;
  background: #fff;
  border-radius: 24px;
  padding: 4px;
  margin-bottom: 12px;
  box-shadow: 0 4px 16px rgba(31,41,55,0.04);
}
.grade-tab {
  flex: 1;
  text-align: center;
  padding: 8px 0;
  border-radius: 20px;
  font-size: 14px;
  color: #5b6478;
}
.grade-tab.active {
  background: #c8102e;
  color: #fff;
  font-weight: 500;
}

.section-title {
  font-size: 15px;
  font-weight: 600;
  margin: 16px 4px 10px;
}
.center { text-align: center; padding: 20px; }

.res-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}
.res-card {
  width: calc(50% - 5px);
  background: #fff;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 4px 16px rgba(31,41,55,0.04);
}
.res-cover {
  height: 90px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 16px;
  font-weight: 600;
}
.cover-text { text-shadow: 0 2px 8px rgba(0,0,0,0.2); }
.res-title {
  font-size: 13px;
  font-weight: 500;
  padding: 8px 10px 4px;
  line-height: 1.4;
  height: 36px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.res-meta {
  display: flex;
  justify-content: space-between;
  padding: 0 10px 8px;
  font-size: 11px;
}