<view class="container">
  <!-- 用户信息卡 -->
  <view class="user-card">
    <image class="avatar" src="{{user.avatar || '/assets/avatar_default.png'}}"></image>
    <view class="user-info">
      <view class="name">{{user.name}}</view>
      <view class="role muted">{{user.role === 'STUDENT' ? '同学' : user.role === 'TEACHER' ? '老师' : '其他'}}</view>
    </view>
    <view class="credit-block">
      <view class="credit-label">总学分</view>
      <view class="credit-num">{{user.studentId ? '--' : '--'}}</view>
    </view>
  </view>

  <!-- 快捷入口 -->
  <view class="quick-row">
    <view class="quick-item" bindtap="onTabTasks">
      <view class="quick-ico">📝</view>
      <view class="quick-text">今日作业</view>
    </view>
    <view class="quick-item" bindtap="onTabStudy">
      <view class="quick-ico">📚</view>
      <view class="quick-text">资料库</view>
    </view>
    <view class="quick-item" bindtap="onTabFeed">
      <view class="quick-ico">💬</view>
      <view class="quick-text">班级圈</view>
    </view>
    <view class="quick-item" bindtap="onTabMe">
      <view class="quick-ico">🏆</view>
      <view class="quick-text">我的</view>
    </view>
  </view>

  <!-- 年级切换 -->
  <view class="grade-bar">
    <block wx:for="{{['初一','初二','初三']}}" wx:key="*this">
      <view class="grade-tab {{grade === item ? 'active' : ''}}" data-g="{{item}}" bindtap="onGradeChange">{{item}}</view>
    </block>
  </view>

  <!-- 课程资料推荐 -->
  <view class="section-title">🎯 {{grade}} 推荐资料</view>
  <view wx:if="{{loading}}" class="muted center">加载中…</view>
  <view wx:elif="{{resources.length === 0}}" class="muted center">暂无资料</view>
  <view wx:else class="res-grid">
    <view wx:for="{{resources}}" wx:key="id" class="res-card" data-id="{{item.id}}" bindtap="goDetail">
      <view class="res-cover" style="background: linear-gradient(135deg, #2e6ca4, #c8102e);">
        <text class="cover-text">{{item.subject}}</text>
      </view>
      <view class="res-title">{{item.title}}</view>
      <view class="res-meta">
        <text class="tag">{{item.type === 'article' ? '图文' : item.type === 'video' ? '视频' : '文档'}}</text>
        <text class="muted">👁 {{item.view_count || 0}}</text>
      </view>
    </view>
  </view>

  <!-- 底部 banner 广告位（待开通广告位后启用） -->
  <!-- <ad unit-id="adunit-xxxx" ad-type="banner"></ad> -->
</view>