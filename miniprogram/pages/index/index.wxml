<view class="container">
  <!-- 用户信息卡 -->
  <view class="user-card">
    <image class="avatar" src="{{user.avatar || '/assets/avatar_default.png'}}"></image>
    <view class="user-info">
      <view class="name">{{user.name}}</view>
      <view class="role muted">{{user.role === 'STUDENT' ? '同学' : user.role === 'TEACHER' ? '管理员' : '其他'}}</view>
    </view>
    <view class="credit-block">
      <view class="credit-label">总积分</view>
      <view class="credit-num">{{user.studentId ? '--' : '--'}}</view>
    </view>
  </view>

  <!-- 快捷入口 -->
  <view class="quick-row">
    <view class="quick-item" bindtap="onTabTasks">
      <view class="quick-ico" style="background:linear-gradient(135deg,#FFB23E,#FF7E6B)">📝</view>
      <view class="quick-text">今日作业</view>
    </view>
    <view class="quick-item" bindtap="onTabStudy">
      <view class="quick-ico" style="background:linear-gradient(135deg,#7C5CFF,#4D9BFF)">📚</view>
      <view class="quick-text">资料库</view>
    </view>
    <view class="quick-item" bindtap="onTabFeed">
      <view class="quick-ico" style="background:linear-gradient(135deg,#2DD4A7,#38D9C9)">💬</view>
      <view class="quick-text">成长圈</view>
    </view>
    <view class="quick-item" bindtap="onTabMe">
      <view class="quick-ico" style="background:linear-gradient(135deg,#FF7EB3,#FF758C)">🏆</view>
      <view class="quick-text">我的</view>
    </view>
  </view>

  <!-- 学习资料推荐（中性定位） -->
  <view class="section-title">🎯 学习资料推荐</view>
  <view wx:if="{{loading}}" class="muted center">加载中…</view>
  <view wx:elif="{{resources.length === 0}}" class="muted center">暂无资料</view>
  <view wx:else class="res-grid">
    <view wx:for="{{resources}}" wx:key="id" class="res-card" data-id="{{item.id}}" bindtap="goDetail">
      <view class="res-cover" style="background: linear-gradient(135deg, #7C5CFF, #4D9BFF);">
        <text class="sub-tag">{{item.type === 'article' ? '图文' : item.type === 'video' ? '视频' : '文档'}}</text>
        <text class="cover-text">{{item.type === 'article' ? '图文' : item.type === 'video' ? '视频' : '文档'}}</text>
      </view>
      <view class="res-title">{{item.title}}</view>
      <view class="res-meta">
        <text class="tag">{{item.type === 'article' ? '图文' : item.type === 'video' ? '视频' : '文档'}}</text>
        <text class="muted">👁 {{item.view_count || 0}}</text>
      </view>
    </view>
  </view>

  <!-- 底部 banner 广告位（待开通广告位后启用） -->
  <!-- <ad unit-id="adunit-xxxx" ad-type="banner"></ad> -->
</view>