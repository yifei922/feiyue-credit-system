<view class="container">
  <view class="search-bar">
    <input class="search" placeholder="搜索资料标题/标签" value="{{keyword}}" bindinput="onSearchInput" bindconfirm="onSearchConfirm" />
  </view>

  <view class="grade-bar">
    <block wx:for="{{grades}}" wx:key="*this">
      <view class="grade-tab {{grade === item ? 'active' : ''}}" data-g="{{item}}" bindtap="onGradeChange">{{item}}</view>
    </block>
  </view>

  <scroll-view scroll-x class="subj-bar">
    <view class="subj-tab {{!subject ? 'active' : ''}}" data-s="" bindtap="onSubjectChange">全部</view>
    <block wx:for="{{subjects}}" wx:key="*this">
      <view class="subj-tab {{subject === item ? 'active' : ''}}" data-s="{{item}}" bindtap="onSubjectChange">{{item}}</view>
    </block>
  </scroll-view>

  <view wx:if="{{loading}}" class="muted center">加载中…</view>
  <view wx:elif="{{list.length === 0}}" class="muted center">暂无资料</view>
  <view wx:else class="list">
    <view wx:for="{{list}}" wx:key="id" class="item card" data-id="{{item.id}}" bindtap="goDetail">
      <view class="item-title">{{item.title}}</view>
      <view class="item-desc muted">{{item.description || '暂无描述'}}</view>
      <view class="item-meta">
        <text class="tag">{{item.subject}}</text>
        <text class="tag tag-green">{{item.type === 'article' ? '图文' : item.type === 'video' ? '视频' : item.type === 'pdf' ? '文档' : '外链'}}</text>
        <text wx:if="{{item.source}}" class="muted source">来源：{{item.source}}</text>
      </view>
      <view class="item-stats">
        <text class="muted">👁 {{item.view_count || 0}} 次浏览</text>
        <text wx:if="{{item.unlock_count}}" class="muted">🎬 已解锁 {{item.unlock_count}} 次</text>
      </view>
    </view>
  </view>
</view>