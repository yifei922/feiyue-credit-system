.search-bar { background: #fff; border-radius: 24px; padding: 8px 14px; margin-bottom: 12px; box-shadow: 0 4px 16px rgba(31,41,55,0.04); }
.search { font-size: 14px; }
.grade-bar { display: flex; background: #fff; border-radius: 24px; padding: 4px; margin-bottom: 12px; box-shadow: 0 4px 16px rgba(31,41,55,0.04); }
.grade-tab { flex: 1; text-align: center; padding: 8px 0; border-radius: 20px; font-size: 13px; color: #5b6478; }
.grade-tab.active { background: #c8102e; color: #fff; }
.subj-bar { white-space: nowrap; padding-bottom: 4px; }
.subj-tab { display: inline-block; padding: 6px 14px; border-radius: 16px; background: #fff; color: #5b6478; font-size: 13px; margin-right: 6px; box-shadow: 0 2px 8px rgba(31,41,55,0.04); }
.subj-tab.active { background: #c8102e; color: #fff; }
.center { text-align: center; padding: 30px; }
.list { margin-top: 4px; }
.item-title { font-size: 15px; font-weight: 600; line-height: 1.4; margin-bottom: 4px; }
.item-desc { font-size: 13px; line-height: 1.5; margin-bottom: 8px; }
.item-meta { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; margin-bottom: 4px; }
.source { font-size: 11px; }
.item-stats { display: flex; gap: 12px; font-size: 12px; margin-top: 4px; }