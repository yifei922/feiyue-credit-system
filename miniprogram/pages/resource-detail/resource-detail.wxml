<view class="container">
  <view wx:if="{{!loaded}}" class="muted center">加载中…</view>
  <block wx:elif="{{res}}">
    <view class="card">
      <view class="res-title">{{res.title}}</view>
      <view class="meta">
        <text class="tag">{{res.grade}}</text>
        <text class="tag">{{res.subject}}</text>
        <text class="tag tag-green">{{res.type === 'article' ? '图文' : res.type === 'video' ? '视频' : '文档'}}</text>
      </view>
      <view wx:if="{{res.description}}" class="desc">{{res.description}}</view>
      <view wx:if="{{res.source}}" class="muted source">来源：{{res.source}}</view>
    </view>

    <view class="points-tip card">
      <view class="muted">当前积分：<text class="pts">{{pointsBalance}}</text>　·　每次查阅/下载扣 <text class="pts">{{pointsCost}}</text> 积分</view>
    </view>

    <!-- 当天未看广告：先看悬浮窗广告解锁 -->
    <view wx:if="{{res.requiresAd}}" class="ad-block card">
      <view class="ad-title">🎬 观看广告即可免费查看</view>
      <view class="muted">打开资料前需先看一段广告（看完才能查看，且不重复扣费）。</view>
      <button class="btn-primary" loading="{{viewing}}" bindtap="onView">▶ 看广告并查看资料</button>
    </view>

    <!-- 已解锁：直接查看（每次仍扣积分） -->
    <view wx:else class="open-block card">
      <button class="btn-primary" loading="{{viewing}}" bindtap="onView" wx:if="{{canView}}">📖 查看 / 下载资料</button>
      <view wx:else class="muted warn">⚠ 积分不足（需 {{pointsCost}}，当前 {{pointsBalance}}）。去看广告或完成任务赚积分后再来。</view>
    </view>
  </block>
</view>
