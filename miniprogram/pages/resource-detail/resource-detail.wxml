<view class="container">
  <view wx:if="{{!loaded}}" class="muted center">加载中…</view>
  <block wx:elif="{{res}}">
    <!-- 资料头部 -->
    <view class="card">
      <view class="res-title">{{res.title}}</view>
      <view class="meta">
        <text class="tag">{{res.grade}}</text>
        <text class="tag">{{res.subject}}</text>
        <text class="tag tag-green">{{res.type === 'article' ? '图文' : res.type === 'video' ? '视频' : '文档'}}</text>
      </view>
      <view wx:if="{{res.description}}" class="desc">{{res.description}}</view>
      <view wx:if="{{res.source}}" class="muted source">来源：{{res.source}}</view>
    </view>

    <!-- 付费墙提示：汇编内容受门控且当前不可见 -->
    <view wx:if="{{contentGated && !contentVisible}}" class="ad-block card">
      <view class="ad-title">🔒 汇编内容受保护</view>
      <view class="muted">该资料汇编需消耗 {{pointsCost}} 积分或观看广告后查看（外链资料始终需广告+积分）。</view>
    </view>

    <!-- ★ 内联内容展示（优先于外部链接） -->
    <block wx:if="{{res.content && res.content.sections}}">
      <view class="content-card" wx:for="{{res.content.sections}}" wx:key="h">
        <view class="sec-title">{{item.h}}</view>
        <view class="sec-item" wx:for="{{item.items}}" wx:for-item="it" wx:key="*this">
          <text class="sec-bullet">▸</text>
          <text class="sec-text">{{it}}</text>
        </view>
      </view>
    </block>

    <!-- 积分提示 + 查看按钮（有外部链接时才显示） -->
    <view wx:if="{{res.url}}" class="points-tip card">
      <view class="muted">当前积分：<text class="pts">{{pointsBalance}}</text>　·　每次查阅/下载扣 <text class="pts">{{pointsCost}}</text> 积分</view>
    </view>

    <view wx:elif="{{res.url}}" class="open-block card">
      <button class="btn-primary" loading="{{viewing}}" bindtap="onView" wx:if="{{canView}}">📖 查看 / 下载资料</button>
      <view wx:else class="muted warn">⚠ 积分不足（需 {{pointsCost}}，当前 {{pointsBalance}}）。请完成任务赚积分后再来。</view>
    </view>

    <!-- 无内容也无链接的兜底 -->
    <view wx:elif="{{!res.content && !res.url}}" class="empty-card card">
      <view class="empty-icon">📭</view>
      <view class="empty-text">该资料正在整理中，敬请期待</view>
      <view class="muted empty-sub">主理人会在管理后台尽快补充完整内容</view>
    </view>
  </block>
</view>