/* app.wxss - 青春版全局设计系统（极光紫蓝主色 · 玻璃拟态卡片 · 学科色标签） */
page {
  background: #f4f5fb;
  color: #1b1f3b;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 14px;
  line-height: 1.55;
}
.container { padding: 16px; }
.row { display: flex; align-items: center; }
.col { display: flex; flex-direction: column; }
.spacer { flex: 1; }
.muted { color: #7a82a6; }
.danger { color: #ff5c7c; }
.success { color: #1f8a5f; }

/* 品牌渐变工具类 */
.brand-grad { background: linear-gradient(135deg, #7C5CFF 0%, #4D9BFF 100%); }
.warm-grad  { background: linear-gradient(135deg, #FF7EB3 0%, #FF758C 100%); }
.sun-grad   { background: linear-gradient(135deg, #FFB23E 0%, #FF7E6B 100%); }
.mint-grad  { background: linear-gradient(135deg, #2DD4A7 0%, #38D9C9 100%); }

/* 卡片 */
.card { background:#fff; border-radius:20px; padding:16px; margin-bottom:14px; box-shadow:0 6px 18px rgba(90,80,200,0.08); }

/* 标签 */
.tag { display:inline-block; padding:3px 10px; border-radius:10px; font-size:11px; font-weight:700; color:#fff; margin-right:6px; background:#7C5CFF; }
.tag-red { background:#ff5c7c; }
.tag-green { background:#2DD4A7; }

/* 按钮 */
.btn-primary { background:linear-gradient(135deg,#7C5CFF 0%,#4D9BFF 100%); color:#fff; border-radius:16px; padding:13px; text-align:center; font-weight:800; box-shadow:0 10px 24px rgba(124,92,255,.32); border:0; font-size:15px; }
.btn-ghost { background:#f1eeff; color:#7C5CFF; border-radius:16px; padding:13px; text-align:center; font-weight:800; border:0; font-size:15px; }
.btn-warm { background:linear-gradient(135deg,#FF7EB3 0%,#FF758C 100%); box-shadow:0 10px 24px rgba(255,107,157,.32); }

.divider { height:1px; background:#eef0f6; margin:12px 0; }

/* 通用标题 */
.section-title { font-size:16px; font-weight:800; margin:6px 4px 12px; }
.center { text-align:center; padding:30px 16px; color:#7a82a6; }

/* Hero 头图 */
.hero { margin:0 -16px 16px; padding:20px 20px 26px; color:#fff; background:linear-gradient(135deg,#7C5CFF 0%,#4D9BFF 100%); border-radius:0 0 30px 30px; box-shadow:0 10px 30px rgba(124,92,255,.22); position:relative; overflow:hidden; }
.hero::after { content:""; position:absolute; width:160px; height:160px; right:-50px; bottom:-70px; background:radial-gradient(circle,rgba(255,255,255,.25),transparent 70%); }
