# 复制为 .env 并填入真实值（.env 不入库）
# 微信小程序凭证（Render / Docker / 纯Node 共用）
WX_APP_ID=wx0fe78d74fdc47c1b
WX_APP_SECRET=请替换为重置后的真实AppSecret

# JWT 签名密钥（生产必须设置！缺失则服务拒绝启动）
# 生成命令: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=please-change-in-prod-run-node-else

# 可选：覆盖后端端口（compose 中已默认 8080）
# PORT=8080
# 可选：Token 过期时间（默认 12h）
# TOKEN_EXPIRES=12h
